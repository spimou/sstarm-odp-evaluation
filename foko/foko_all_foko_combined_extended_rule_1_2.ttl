                              owl:someValuesFrom ns1:E72_Legal_Object
                            ] ,
                            [ rdf:type owl:Restriction ;
                              owl:onProperty ns1:P129i_is_subject_of ;
                              owl:someValuesFrom ns1:E1_CRM_Entity
                            ] ,
                            [ rdf:type owl:Restriction ;
                              owl:onProperty ns1:P148_has_component ;
                              owl:someValuesFrom ns1:E89_Propositional_Object
                            ] .


