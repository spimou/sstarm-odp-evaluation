###  http://id.gnm.de/ont/foko/Additional_Sources
ns1:Additional_Sources rdf:type owl:Class ;
                       rdfs:subClassOf ns1:E31_Document ,
                                       ns1:E73_Information_Object ,
                                       ns1:E89_Propositional_Object ,
                                       ns1:E90_Symbolic_Object ,
                                       [ rdf:type owl:Restriction ;
                                         owl:onProperty ns1:P70_documents ;
                                         owl:someValuesFrom ns1:E1_CRM_Entity
                                       ] ;
                       rdfs:comment """<p style=\"margin-top: 0\">
