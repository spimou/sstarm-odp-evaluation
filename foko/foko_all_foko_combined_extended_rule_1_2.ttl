                     rdfs:subClassOf ns1:E28_Conceptual_Object ,
                                     ns1:E55_Type ,
                                     ns1:Role ,
                                     [ rdf:type owl:Restriction ;
                                       owl:onProperty ns1:P135i_was_created_by ;
                                       owl:maxCardinality "1"^^xsd:nonNegativeInteger
                                     ] .


###  http://id.gnm.de/ont/foko/Institution_Role_Event
ns1:Institution_Role_Event rdf:type owl:Class ;
                           rdfs:subClassOf ns1:E2_Temporal_Entity ,
                                           ns1:E4_Period ,
                                           ns1:E5_Event ,
                                           [ rdf:type owl:Restriction ;
                                             owl:onProperty ns1:P12_occurred_in_the_presence_of ;
                                             owl:someValuesFrom ns1:E77_Persistent_Item
                                           ] ,
                                           [ rdf:type owl:Restriction ;
                                             owl:onProperty ns1:P7_took_place_at ;
                                             owl:someValuesFrom ns1:E53_Place
                                           ] .


###  http://id.gnm.de/ont/foko/Inventory_Number
ns1:Inventory_Number rdf:type owl:Class ;
                     rdfs:subClassOf ns1:E41_Appellation ,
                                     ns1:E42_Identifier ,
                                     ns1:E90_Symbolic_Object ;
                     rdfs:comment """<p style=\"margin-top: 0\">
      valid only for photo-inventory-number
    </p>""" .


