###  http://id.gnm.de/ont/foko/Mixed_Lot
ns1:Mixed_Lot rdf:type owl:Class ;
              rdfs:subClassOf ns1:E18_Physical_Thing ,
                              ns1:E19_Physical_Object ,
                              ns1:E24_Physical_Man-Made_Thing ,
                              ns1:E71_Man-Made_Thing ,
                              ns1:E78_Collection ,
                              [ rdf:type owl:Restriction ;
                                owl:onProperty ns1:P108i_was_produced_by ;
                                owl:someValuesFrom ns1:E12_Production
                              ] ,
                              [ rdf:type owl:Restriction ;
                                owl:onProperty ns1:P109_has_current_or_former_curator ;
                                owl:someValuesFrom ns1:E39_Actor
                              ] ,
                              [ rdf:type owl:Restriction ;
                                owl:onProperty ns1:P54_has_current_permanent_location ;
                                owl:maxCardinality "1"^^xsd:nonNegativeInteger
                              ] ,
                              [ rdf:type owl:Restriction ;
                                owl:onProperty ns1:P55_has_current_location ;
                                owl:maxCardinality "1"^^xsd:nonNegativeInteger
                              ] ;
              rdfs:comment """<p style=\"margin-top: 0\">
      Mixed Lots (Konvolut) are small collections that consist of different 
      documents, especially of photos, that were given to an institution by a 
      collector, e.g. &quot;Sammlung Arczy&#324;ski&quot;.
    </p>""" .


