###  http://id.gnm.de/ont/foko/Role
ns1:Role rdf:type owl:Class ;
         rdfs:subClassOf ns1:E28_Conceptual_Object ,
                         ns1:E55_Type ,
                         ns1:E71_Man-Made_Thing ,
                         [ rdf:type owl:Restriction ;
                           owl:onProperty ns1:P94i_was_created_by ;
                           owl:someValuesFrom ns1:E65_Creation
                         ] ,
                         [ rdf:type owl:Restriction ;
                           owl:onProperty ns1:P135i_was_created_by ;
                           owl:maxCardinality "1"^^xsd:nonNegativeInteger
                         ] ;
         rdfs:comment """<p style=\"margin-top: 0\">
      The E55 subclass &quot;Role&quot; describes the role or function an E39 actor 
      plays within a certain context,
    </p>
    <p style=\"margin-top: 0\">
      
    </p>
    <p style=\"margin-top: 0\">
      e.g. Leonardo DaVinci invented objects, but also painted paintings.
    </p>
    <p style=\"margin-top: 0\">
      &quot;Role&quot; in this case enables to specify DaVinci as inventor, or painter 
      in the creational context of certain things.
    </p>""" .


