###  http://www.w3.org/1999/02/22-rdf-syntax-ns#first
rdf:first rdfs:domain rdfs:Resource .


###  http://www.w3.org/1999/02/22-rdf-syntax-ns#object
rdf:object rdfs:domain rdfs:Resource .


###  http://www.w3.org/1999/02/22-rdf-syntax-ns#predicate
rdf:predicate rdfs:domain rdfs:Resource .


###  http://www.w3.org/1999/02/22-rdf-syntax-ns#rest
rdf:rest rdfs:domain rdfs:Resource ;
         rdfs:range rdfs:Resource .


###  http://www.w3.org/1999/02/22-rdf-syntax-ns#subject
rdf:subject rdfs:domain rdfs:Resource .


###  http://www.w3.org/1999/02/22-rdf-syntax-ns#type
rdf:type rdfs:range rdfs:Resource .


###  http://www.w3.org/2000/01/rdf-schema#domain
rdfs:domain rdfs:domain rdfs:Resource ;
            rdfs:range rdfs:Resource .


###  http://www.w3.org/2000/01/rdf-schema#range
rdfs:range rdfs:domain rdfs:Resource ;
           rdfs:range rdfs:Resource .


###  http://www.w3.org/2000/01/rdf-schema#subClassOf
rdfs:subClassOf rdfs:domain rdfs:Resource ;
                rdfs:range rdfs:Resource .


###  http://www.w3.org/2000/01/rdf-schema#subPropertyOf
rdfs:subPropertyOf rdfs:domain rdfs:Resource ;
                   rdfs:range rdfs:Resource .


###  http://www.w3.org/2002/07/owl#allValuesFrom
owl:allValuesFrom rdfs:domain rdfs:Class ,
                              rdfs:Resource ,
                              owl:Class ;
                  rdfs:range rdfs:Resource .


###  http://www.w3.org/2002/07/owl#assertionProperty
owl:assertionProperty rdfs:domain rdfs:Resource ;
                      rdfs:range rdfs:Resource .


###  http://www.w3.org/2002/07/owl#complementOf
owl:complementOf rdfs:domain rdfs:Class ,
                             rdfs:Resource ;
                 rdfs:range rdfs:Class ,
                            rdfs:Resource .


###  http://www.w3.org/2002/07/owl#datatypeComplementOf
owl:datatypeComplementOf rdfs:domain rdfs:Class ,
                                     rdfs:Resource ;
                         rdfs:range rdfs:Class ,
                                    rdfs:Resource .


###  http://www.w3.org/2002/07/owl#disjointUnionOf
owl:disjointUnionOf rdfs:domain rdfs:Class ,
                                rdfs:Resource ;
                    rdfs:range rdfs:Resource .


###  http://www.w3.org/2002/07/owl#disjointWith
owl:disjointWith rdfs:domain rdfs:Class ,
                             rdfs:Resource ;
                 rdfs:range rdfs:Class ,
                            rdfs:Resource .


###  http://www.w3.org/2002/07/owl#distinctMembers
owl:distinctMembers rdfs:domain rdfs:Resource ;
                    rdfs:range rdfs:Resource .


###  http://www.w3.org/2002/07/owl#equivalentClass
owl:equivalentClass rdfs:domain rdfs:Resource ;
                    rdfs:range rdfs:Resource .


###  http://www.w3.org/2002/07/owl#equivalentProperty
owl:equivalentProperty rdfs:domain rdfs:Resource ;
                       rdfs:range rdfs:Resource .


###  http://www.w3.org/2002/07/owl#hasKey
owl:hasKey rdfs:domain rdfs:Class ,
                       rdfs:Resource ;
           rdfs:range rdfs:Resource .


###  http://www.w3.org/2002/07/owl#hasSelf
owl:hasSelf rdfs:domain rdfs:Class ,
                        rdfs:Resource ,
                        owl:Class .


###  http://www.w3.org/2002/07/owl#hasValue
owl:hasValue rdfs:domain rdfs:Class ,
                         rdfs:Resource ,
                         owl:Class .


###  http://www.w3.org/2002/07/owl#intersectionOf
owl:intersectionOf rdfs:domain rdfs:Resource ;
                   rdfs:range rdfs:Resource .


###  http://www.w3.org/2002/07/owl#inverseOf
owl:inverseOf rdfs:domain rdf:Property ,
                          rdfs:Resource ;
              rdfs:range rdf:Property ,
                         rdfs:Resource .


###  http://www.w3.org/2002/07/owl#members
owl:members rdfs:range rdfs:Resource .


###  http://www.w3.org/2002/07/owl#onClass
owl:onClass rdfs:domain rdfs:Class ,
                        rdfs:Resource ,
                        owl:Class ;
            rdfs:range rdfs:Class ,
                       rdfs:Resource .


###  http://www.w3.org/2002/07/owl#onDataRange
owl:onDataRange rdfs:domain rdfs:Class ,
                            rdfs:Resource ,
                            owl:Class ;
                rdfs:range rdfs:Class ,
                           rdfs:Resource .


###  http://www.w3.org/2002/07/owl#onDatatype
owl:onDatatype rdfs:domain rdfs:Class ,
                           rdfs:Resource ;
               rdfs:range rdfs:Class ,
                          rdfs:Resource .


###  http://www.w3.org/2002/07/owl#onProperties
owl:onProperties rdfs:domain rdfs:Class ,
                             rdfs:Resource ,
                             owl:Class ;
                 rdfs:range rdfs:Resource .


