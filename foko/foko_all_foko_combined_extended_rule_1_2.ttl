                                    owl:someValuesFrom ns1:E30_Right
                                  ] ,
                                  [ rdf:type owl:Restriction ;
                                    owl:onProperty ns1:P107_has_current_or_former_member ;
                                    owl:minCardinality "2"^^xsd:nonNegativeInteger
                                  ] ,
                                  [ rdf:type owl:Restriction ;
                                    owl:onProperty ns1:P144i_gained_member_by ;
                                    owl:minCardinality "2"^^xsd:nonNegativeInteger
                                  ] ,
                                  [ rdf:type owl:Restriction ;
                                    owl:onProperty ns1:P146i_lost_member_by ;
                                    owl:minCardinality "0"^^xsd:nonNegativeInteger
                                  ] ,
                                  [ rdf:type owl:Restriction ;
                                    owl:onProperty ns1:P95i_was_formed_by ;
                                    owl:maxCardinality "1"^^xsd:nonNegativeInteger
                                  ] .


