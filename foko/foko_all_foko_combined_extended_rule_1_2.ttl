###  http://id.gnm.de/ont/foko/Type_of_Dating
ns1:Type_of_Dating rdf:type owl:Class ;
                   rdfs:subClassOf ns1:E28_Conceptual_Object ,
                                   ns1:E55_Type ,
                                   ns1:E71_Man-Made_Thing ,
                                   [ rdf:type owl:Restriction ;
                                     owl:onProperty ns1:P94i_was_created_by ;
                                     owl:someValuesFrom ns1:E65_Creation
                                   ] ,
                                   [ rdf:type owl:Restriction ;
                                     owl:onProperty ns1:P135i_was_created_by ;
                                     owl:maxCardinality "1"^^xsd:nonNegativeInteger
                                   ] ;
                   rdfs:comment """<p style=\"margin-top: 0\">
      Art der Datierung, gibt insbesondere f&#252;r die Manifestation,
    </p>
    <p style=\"margin-top: 0\">
      z.B. wann wurde der Abzug gemacht, wann wurde Retusche gemacht, usw.
    </p>""" .


###  http://id.gnm.de/ont/foko/Type_of_Dating_Appellation
ns1:Type_of_Dating_Appellation rdf:type owl:Class ;
                               rdfs:subClassOf ns1:E41_Appellation ,
                                               ns1:E75_Conceptual_Object_Appellation ,
                                               ns1:E90_Symbolic_Object .


###  http://id.gnm.de/ont/foko/Type_of_Inscription
ns1:Type_of_Inscription rdf:type owl:Class ;
                        rdfs:subClassOf ns1:E28_Conceptual_Object ,
                                        ns1:E55_Type ,
                                        ns1:E71_Man-Made_Thing ,
                                        [ rdf:type owl:Restriction ;
                                          owl:onProperty ns1:P94i_was_created_by ;
                                          owl:someValuesFrom ns1:E65_Creation
                                        ] ,
                                        [ rdf:type owl:Restriction ;
                                          owl:onProperty ns1:P135i_was_created_by ;
                                          owl:maxCardinality "1"^^xsd:nonNegativeInteger
                                        ] ;
                        rdfs:comment """<p style=\"margin-top: 0\">
      Art der Inschrift; g&#252;ltig f&#252;r dargestelltes Objekt
    </p>""" .


###  http://id.gnm.de/ont/foko/Type_of_Inscription_Appellation
ns1:Type_of_Inscription_Appellation rdf:type owl:Class ;
                                    rdfs:subClassOf ns1:E41_Appellation ,
                                                    ns1:E75_Conceptual_Object_Appellation ,
                                                    ns1:E90_Symbolic_Object .


###  http://id.gnm.de/ont/foko/Type_of_Mark
ns1:Type_of_Mark rdf:type owl:Class ;
                 rdfs:subClassOf ns1:E28_Conceptual_Object ,
                                 ns1:E55_Type ,
                                 ns1:E71_Man-Made_Thing ,
                                 [ rdf:type owl:Restriction ;
                                   owl:onProperty ns1:P94i_was_created_by ;
                                   owl:someValuesFrom ns1:E65_Creation
                                 ] ,
                                 [ rdf:type owl:Restriction ;
                                   owl:onProperty ns1:P135i_was_created_by ;
                                   owl:maxCardinality "1"^^xsd:nonNegativeInteger
                                 ] ;
                 rdfs:comment """<p style=\"margin-top: 0\">
      Art der Marke, z.B. Stempel, Punze, etc.
    </p>""" .


###  http://id.gnm.de/ont/foko/Type_of_Mark_Appellation
ns1:Type_of_Mark_Appellation rdf:type owl:Class ;
                             rdfs:subClassOf ns1:E41_Appellation ,
                                             ns1:E75_Conceptual_Object_Appellation ,
                                             ns1:E90_Symbolic_Object .


###  http://id.gnm.de/ont/foko/Type_of_Mixed_Lot
ns1:Type_of_Mixed_Lot rdf:type owl:Class ;
                      rdfs:subClassOf ns1:E28_Conceptual_Object ,
                                      ns1:E55_Type ,
                                      ns1:E71_Man-Made_Thing ,
                                      [ rdf:type owl:Restriction ;
                                        owl:onProperty ns1:P94i_was_created_by ;
                                        owl:someValuesFrom ns1:E65_Creation
                                      ] ,
                                      [ rdf:type owl:Restriction ;
                                        owl:onProperty ns1:P135i_was_created_by ;
                                        owl:maxCardinality "1"^^xsd:nonNegativeInteger
                                      ] .


###  http://id.gnm.de/ont/foko/Type_of_Photo
ns1:Type_of_Photo rdf:type owl:Class ;
                  rdfs:subClassOf ns1:E28_Conceptual_Object ,
                                  ns1:E55_Type ,
                                  ns1:E71_Man-Made_Thing ,
                                  [ rdf:type owl:Restriction ;
                                    owl:onProperty ns1:P94i_was_created_by ;
                                    owl:someValuesFrom ns1:E65_Creation
                                  ] ,
                                  [ rdf:type owl:Restriction ;
                                    owl:onProperty ns1:P135i_was_created_by ;
                                    owl:maxCardinality "1"^^xsd:nonNegativeInteger
                                  ] ;
                  rdfs:comment """<p style=\"margin-top: 0\">
      Valid only for Expression (Art der Fotografie, z.B. Makrofotografie)
    </p>""" .


###  http://id.gnm.de/ont/foko/Type_of_Photo_Appellation
ns1:Type_of_Photo_Appellation rdf:type owl:Class ;
                              rdfs:subClassOf ns1:E33_Linguistic_Object ,
                                              ns1:E35_Title ,
                                              ns1:E41_Appellation ,
                                              ns1:E73_Information_Object ,
                                              ns1:E75_Conceptual_Object_Appellation ,
                                              [ rdf:type owl:Restriction ;
                                                owl:onProperty ns1:P72_has_language ;
                                                owl:minCardinality "1"^^xsd:nonNegativeInteger
                                              ] ,
                                              [ rdf:type owl:Restriction ;
                                                owl:onProperty ns1:P73i_is_translation_of ;
                                                owl:maxCardinality "1"^^xsd:nonNegativeInteger
                                              ] .


###  http://id.gnm.de/ont/foko/Type_of_Protective_Right
ns1:Type_of_Protective_Right rdf:type owl:Class ;
                             rdfs:subClassOf ns1:E28_Conceptual_Object ,
                                             ns1:E55_Type ,
                                             ns1:E71_Man-Made_Thing ,
                                             [ rdf:type owl:Restriction ;
                                               owl:onProperty ns1:P94i_was_created_by ;
                                               owl:someValuesFrom ns1:E65_Creation
                                             ] ,
                                             [ rdf:type owl:Restriction ;
                                               owl:onProperty ns1:P135i_was_created_by ;
                                               owl:maxCardinality "1"^^xsd:nonNegativeInteger
                                             ] ;
                             rdfs:comment """<p style=\"margin-top: 0\">
      Art des Schutzrechts, g&#252;ltig f&#252;r Expression und Manifestation (Siehe 
      auch Subklassen E30 Manifestation_Property_Right und 
      Expression_Property_Right)
    </p>""" .


###  http://id.gnm.de/ont/foko/Type_of_Protective_Right_Appellation
ns1:Type_of_Protective_Right_Appellation rdf:type owl:Class ;
                                         rdfs:subClassOf ns1:E41_Appellation ,
                                                         ns1:E75_Conceptual_Object_Appellation ,
                                                         ns1:E90_Symbolic_Object .


###  http://id.gnm.de/ont/foko/Type_of_Relation
ns1:Type_of_Relation rdf:type owl:Class ;
                     rdfs:subClassOf ns1:E28_Conceptual_Object ,
                                     ns1:E55_Type ,
                                     ns1:E71_Man-Made_Thing ,
                                     [ rdf:type owl:Restriction ;
                                       owl:onProperty ns1:P94i_was_created_by ;
                                       owl:someValuesFrom ns1:E65_Creation
                                     ] ,
                                     [ rdf:type owl:Restriction ;
                                       owl:onProperty ns1:P135i_was_created_by ;
                                       owl:maxCardinality "1"^^xsd:nonNegativeInteger
                                     ] .


###  http://id.gnm.de/ont/foko/Type_of_Relation_Appellation
ns1:Type_of_Relation_Appellation rdf:type owl:Class ;
                                 rdfs:subClassOf ns1:E41_Appellation ,
                                                 ns1:E75_Conceptual_Object_Appellation ,
                                                 ns1:E90_Symbolic_Object .


###  http://id.gnm.de/ont/foko/Type_of_Text
ns1:Type_of_Text rdf:type owl:Class ;
                 rdfs:subClassOf ns1:E28_Conceptual_Object ,
                                 ns1:E55_Type ,
                                 ns1:E71_Man-Made_Thing ,
                                 [ rdf:type owl:Restriction ;
                                   owl:onProperty ns1:P94i_was_created_by ;
                                   owl:someValuesFrom ns1:E65_Creation
                                 ] ,
                                 [ rdf:type owl:Restriction ;
                                   owl:onProperty ns1:P135i_was_created_by ;
                                   owl:maxCardinality "1"^^xsd:nonNegativeInteger
                                 ] ;
                 rdfs:comment """<p style=\"margin-top: 0\">
      F&#252;r die Art des Textes auf einer Manifestation, z.B.f&#252;r Beschriftungen 
      des Fotos, nicht f&#252;r Inschriften auf dargestelltem Objekt.
    </p>""" .


###  http://id.gnm.de/ont/foko/Type_of_Text_Appellation
ns1:Type_of_Text_Appellation rdf:type owl:Class ;
                             rdfs:subClassOf ns1:E41_Appellation ,
                                             ns1:E75_Conceptual_Object_Appellation ,
                                             ns1:E90_Symbolic_Object .


###  http://id.gnm.de/ont/foko/Usage_Conditions
ns1:Usage_Conditions rdf:type owl:Class ;
                     rdfs:subClassOf ns1:E31_Document ,
                                     ns1:E73_Information_Object ,
                                     ns1:E89_Propositional_Object ,
                                     ns1:E90_Symbolic_Object ,
                                     [ rdf:type owl:Restriction ;
                                       owl:onProperty ns1:P70_documents ;
                                       owl:someValuesFrom ns1:E1_CRM_Entity
                                     ] .


###  http://id.gnm.de/ont/foko/Use_Assignment
ns1:Use_Assignment rdf:type owl:Class ;
                   rdfs:subClassOf ns1:E13_Attribute_Assignment ,
                                   ns1:E17_Type_Assignment ,
                                   ns1:E7_Activity ,
                                   [ rdf:type owl:Restriction ;
                                     owl:onProperty ns1:P140_assigned_attribute_to ;
                                     owl:someValuesFrom ns1:E1_CRM_Entity
                                   ] ,
                                   [ rdf:type owl:Restriction ;
                                     owl:onProperty ns1:P42_assigned ;
                                     owl:someValuesFrom ns1:E55_Type
                                   ] ,
                                   [ rdf:type owl:Restriction ;
                                     owl:onProperty ns1:P41_classified ;
                                     owl:cardinality "1"^^xsd:nonNegativeInteger
                                   ] .


###  http://id.gnm.de/ont/foko/Vernacular_Actor_Appelation
ns1:Vernacular_Actor_Appelation rdf:type owl:Class ;
                                rdfs:subClassOf ns1:E41_Appellation ,
                                                ns1:E82_Actor_Appellation ,
                                                ns1:E90_Symbolic_Object .


###  http://id.gnm.de/ont/foko/View
ns1:View rdf:type owl:Class ;
         rdfs:subClassOf ns1:E28_Conceptual_Object ,
                         ns1:E55_Type ,
                         ns1:E71_Man-Made_Thing ,
                         [ rdf:type owl:Restriction ;
                           owl:onProperty ns1:P94i_was_created_by ;
                           owl:someValuesFrom ns1:E65_Creation
                         ] ,
                         [ rdf:type owl:Restriction ;
                           owl:onProperty ns1:P135i_was_created_by ;
                           owl:maxCardinality "1"^^xsd:nonNegativeInteger
                         ] ;
         rdfs:comment """<p style=\"margin-top: 0\">
      Sicht, f&#252;r Expression: Innenaufnahme, Au&#223;enaufnahme
    </p>""" .


###  http://id.gnm.de/ont/foko/Workshop
ns1:Workshop rdf:type owl:Class ;
             rdfs:subClassOf ns1:E39_Actor ,
                             ns1:E40_Legal_Body ,
                             ns1:E74_Group ,
                             [ rdf:type owl:Restriction ;
                               owl:onProperty ns1:P75_possesses ;
                               owl:someValuesFrom ns1:E30_Right
                             ] ,
                             [ rdf:type owl:Restriction ;
                               owl:onProperty ns1:P107_has_current_or_former_member ;
                               owl:minCardinality "2"^^xsd:nonNegativeInteger
                             ] ,
                             [ rdf:type owl:Restriction ;
                               owl:onProperty ns1:P144i_gained_member_by ;
                               owl:minCardinality "2"^^xsd:nonNegativeInteger
                             ] ,
                             [ rdf:type owl:Restriction ;
                               owl:onProperty ns1:P146i_lost_member_by ;
                               owl:minCardinality "0"^^xsd:nonNegativeInteger
                             ] ,
                             [ rdf:type owl:Restriction ;
                               owl:onProperty ns1:P95i_was_formed_by ;
                               owl:maxCardinality "1"^^xsd:nonNegativeInteger
                             ] .


###  http://id.gnm.de/ont/foko/Workshop_Name
ns1:Workshop_Name rdf:type owl:Class ;
                  rdfs:subClassOf ns1:E33_Linguistic_Object ,
                                  ns1:E35_Title ,
                                  ns1:E41_Appellation ,
                                  ns1:E73_Information_Object ,
                                  ns1:E82_Actor_Appellation ,
                                  [ rdf:type owl:Restriction ;
                                    owl:onProperty ns1:P72_has_language ;
                                    owl:minCardinality "1"^^xsd:nonNegativeInteger
                                  ] ,
                                  [ rdf:type owl:Restriction ;
                                    owl:onProperty ns1:P73i_is_translation_of ;
                                    owl:maxCardinality "1"^^xsd:nonNegativeInteger
                                  ] .


###  http://id.gnm.de/ont/foko/Workshop_Role
ns1:Workshop_Role rdf:type owl:Class ;
                  rdfs:subClassOf ns1:E28_Conceptual_Object ,
                                  ns1:E55_Type ,
                                  ns1:Role ,
                                  [ rdf:type owl:Restriction ;
                                    owl:onProperty ns1:P135i_was_created_by ;
                                    owl:maxCardinality "1"^^xsd:nonNegativeInteger
                                  ] .


