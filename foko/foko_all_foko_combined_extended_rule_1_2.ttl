<http://foko2014.gnm.de/content/foko_Transcription104a31> a ns2:Transcription ;
    ns1:P3_has_note "L E" .

<http://foko2014.gnm.de/content/foko_Transcription105433> a ns2:Transcription ;
    ns1:P3_has_note "L E" .

<http://foko2014.gnm.de/content/foko_Transcription1079b0> a ns2:Transcription ;
    ns1:P3_has_note "1523" .

<http://foko2014.gnm.de/content/foko_Transcription11c25e> a ns2:Transcription ;
    ns1:P3_has_note "Chare posteritatis memoriae sit traditum, turrim hanc anno 1676 execrabile et luctuoso illo incendo valde destructam anno 1678 prima industria maiorum restauratum, dein anno 1774 horologio iam obliterato rcparato fuisse vindicatam, dein anno 1894 Herum reparatam." .

<http://foko2014.gnm.de/content/foko_Transcription1206d5> a ns2:Transcription ;
    ns1:P3_has_note "Mathias natus de arras civitate / francie primus magister hujus ecclesie quem Karo/ lus IIII. pro tunc marchio moravie cum / electus fuerat in regem romanorum in avenione / abinde adduxit ad fabricandam ecclesiam / istam quam a fundo incepit. anno D. M. / CCCXLII.. et rexit usque ad annum LII. in / quo obiit." .

<http://foko2014.gnm.de/content/foko_Transcription1210ff> a ns2:Transcription ;
    ns1:P3_has_note "Petrus, henrici arleri. de polonia magistri de gemunden in suevia. secundus magister hujus fabrice. quem imperator Karolus IIII. adduxit de dicta civitate. et fecit eum magistrum hujus ecclesie. et tunc fuerat annorum XXIII. et incepit. rege anno dmi. MCCCLVI. et perfecit chorum istum anno dmi. MCCCLXXXVI. quo anno incepit sedilia chori illius. et infra tempus prescriptum etiam incepit et perfecit chorum omnium sanctorum. et rexit pontem multavie. et incepit a fundo chorum in colonya circa albeam." .

<http://foko2014.gnm.de/content/foko_Transcription123d18> a ns2:Transcription ;
    ns1:P3_has_note "W" .

<http://foko2014.gnm.de/content/foko_Transcription12c980> a ns2:Transcription ;
    ns1:P3_has_note "Stefan Arczyński / Leg. ZPAF Nr 119 / ul. Mianowskiego 2a / 51-605 Wrocław" .

<http://foko2014.gnm.de/content/foko_Transcription19bab9> a ns2:Transcription ;
    ns1:P3_has_note "CONCORDIA RESPUBLICAE PARVAE CRESCUNT DISCORDIA MAGNAE CONCIDUNT" .

<http://foko2014.gnm.de/content/foko_Transcription19bc52> a ns2:Transcription ;
    ns1:P3_has_note "es müsse wohl gehen denen, die dich lieben, es müsse friede sein inwendig in deinen mauren und glück in deinen pallästen" .

<http://foko2014.gnm.de/content/foko_Transcription19d5bc> a ns2:Transcription ;
    ns1:P3_has_note "1627" .

<http://foko2014.gnm.de/content/foko_Transcription1ab3e9> a ns2:Transcription ;
    ns1:P3_has_note "SURGITE MORTUI / VENITE AD IVIDICIVM" .

<http://foko2014.gnm.de/content/foko_Transcription21e630> a ns2:Transcription ;
    ns1:P3_has_note "ANNO, QUO IN HORIZONTE REGNI HUNGARIAE LUXIT VERE SECUNDA SEPTEMBRIS, DEUS AB AUSTRO AUSTRIAM CONTRA TURCAS VIENNAM TRECENTIS PROPE MILLIBUS IN TERTIUM MENSEM FRUSTRA OBSIDENTES, ET CASTRIS, TOTIS, POST TURPEM FUGAM, EXUTOS FORTITER VINDICANS, TRIENNIO POST IN VICTORIARUM AUCTARIUM, BUDAM IPSAM REGNI HUNGARIAE METROPOLIM, TURCICA SOLYMANNI FRAUDE ANNO MDXLI, DIE II. SEPTEMBR. ABREPTAM, GLORIOSE VINDICAVIT AC RESTITUTIT LEGITIMO ET NATURALI REGI SUO LEOPOLDO I., CAESARI AUSTRIACO.  SIT OTHOMANICA FRAUS, VIS, POTENTIA, LUNA SUB PEDIBUS EJUS." .

<http://foko2014.gnm.de/content/foko_Transcription21e637> a ns2:Transcription ;
    ns1:P3_has_note "VIRGINI DEIPARAE SINE MACULA CONCEPTAE DOMUS AUSTRIACAE URGARIAE PRAESIDY PROTECTRICI, IMPERANTE FELICITER LEOPOLDO I., COMMENDANTE HERMANNO MARCHIONE BADENSI, LEOPOLDUS, E.S.R.I. COMITIBUS A KOLONITZ, JAURINENSIUM. EPISCOPUS, EQUES ORD. 8. JOAN. HIEROSOLYMITANI, S.C. REG. M. CONSILIARIUS INTIMUS, GRATUS POSUIT ET CONSECRAVIT S.R.E. CARDINALIS CREATUS DIE II. SEPTEMBRIS." .

<http://foko2014.gnm.de/content/foko_Transcription21f59a> a ns2:Transcription ;
    ns1:P3_has_note "DOVE PACE TRAVAI D’OGNI MIA GUERRA" .

<http://foko2014.gnm.de/content/foko_Transcription232101> a ns2:Transcription ;
    ns1:P3_has_note "ECCE PANIS AGELOR FCTVS CIBVS VIATOR /ARMA REVERENDI DOMINI ANDREE EPI THERMOPYLENSIS" .

<http://foko2014.gnm.de/content/foko_Transcription2321d7> a ns2:Transcription ;
    ns1:P3_has_note "EGO SVM PANIS VIVVS QVI DECELO DESCENDI / ARMA INCLITE CIVITATIS REGALIS PESTHIENSIS MDVII" .

<http://foko2014.gnm.de/content/foko_Transcription2403c4> a ns2:Transcription ;
    ns1:P3_has_note "HOC TIBI FVNDAVIT SVP(er)V(m) REGINA SACELLVM / ORTVS LIPTHOIS LADISLAVS AVIS / HIC P(ro)AVOS VETE(res) POSVIT CHA(r)OSQ(ue) PARE(nt)E(s) / TVTA FORET GREMIO VT TVRBA SEP(ul)TA TVO / HVC ADES ALMA DEI MATER VOTISQVE / FAVETO / S(a)EPIVS ET CLEME(n)S AD TVA TE(m)PLA VENI " .

<http://foko2014.gnm.de/content/foko_Transcription2421e5> a ns2:Transcription ;
    ns1:P3_has_note "TENPLVM DOMINI" .

<http://foko2014.gnm.de/content/foko_Transcription4e0d87> a ns2:Transcription ;
    ns1:P3_has_note "HENRICUS QUARTUS MILLE TRIA CENTUM MINUS X OBIIT ILLE EGREGIIS ANNIS SILESIAE CRACOVIAE SANDOMIRIAE DUX NOCTE JOHANNIS" .

<http://foko2014.gnm.de/content/foko_Transcription52f191> a ns2:Transcription ;
    ns1:P3_has_note "religioni et bonis atribus 1754" .

<http://foko2014.gnm.de/content/foko_Transcription555430> a ns2:Transcription ;
    ns1:P3_has_note "Mater Misericordiae sub Tuum praesidium confugimus" .

<http://foko2014.gnm.de/content/foko_Transcription57df9d> a ns2:Transcription ;
    ns1:P3_has_note "ANNO CHRISTI MDCXXXVI / IOHANNES WEINHART OALASIENSIS SCVPLSIT" .

<http://foko2014.gnm.de/content/foko_Transcription5a6eb7> a ns2:Transcription ;
    ns1:P3_has_note "ANNO ❊ DOMINI ❊ M°CCCLXXXVIII ❊ KOMPLETA ❊ EST ❊ CUM ❊ PORTICU ❊ ECCLESIA ❊ WARMENSIS ❊ AMEN" .

<http://foko2014.gnm.de/content/foko_Transcription5a83ba> a ns2:Transcription ;
    ns1:P3_has_note "Christophorus Zinie Merze a Ladislaus de Zinie" .

<http://foko2014.gnm.de/content/foko_Transcription5ac6ba> a ns2:Transcription ;
    ns1:P3_has_note "ANNO MDXCI. XVIII. SEPTEM" .

