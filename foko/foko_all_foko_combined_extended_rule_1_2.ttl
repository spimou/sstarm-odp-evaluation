<http://foko2014.gnm.de/content/ecrm_E33_Linguistic_Object204f89> a ns1:E33_Linguistic_Object ;
    ns1:P3_has_note "<p>Mausoleum des <span typeof=\"http://id.gnm.de/ont/foko/Person\" about=\"http://foko2014.gnm.de/content/foko_Person1023cd\" class=\"wisski_anno wisski_anno_class_238 wisski_anno_approved wisski_anno_vocab_1 wisski_anno_uri_http%3A%2F%2Ffoko2014.gnm.de%2Fcontent%2Ffoko_Person1023cd \">Stefan, Polen, König</span></p>" .

<http://foko2014.gnm.de/content/ecrm_E33_Linguistic_Object21dc7a> a ns1:E33_Linguistic_Object ;
    ns1:P3_has_note "<p>Im Kircheninneren: Fresken von <span typeof=\"http://id.gnm.de/ont/foko/Person\" about=\"http://foko2014.gnm.de/content/foko_Person23f407\" class=\"wisski_anno wisski_anno_class_238 wisski_anno_approved wisski_anno_vocab_1 wisski_anno_uri_http%3A%2F%2Ffoko2014.gnm.de%2Fcontent%2Ffoko_Person23f407 \">Gebauer, Ernő</span> aus dem Jahre 1929.</p>" .

<http://foko2014.gnm.de/content/ecrm_E33_Linguistic_Object21e88b> a ns1:E33_Linguistic_Object ;
    ns1:P3_has_note "<p style=\"text-indent: 5%;\">Ikonografie:</p><p style=\"text-indent: 5%;\">11F232 = Maria Immaculata (Standbild);</p><p style=\"text-indent: 5%;\">Reliefs am Sockel: 11HH(ROSALIA)36 = die heilige Rosalia als Eremitin in einer Höhle; 11HH(ELISABETH OF HUNGARY) = Elisabeth von Thüringen, Ehefrau und Witwe des Landgrafs von Thüringen, franziskanische Terziarin; <span style=\"font-size: 11.0pt; font-family: 'Calibri',sans-serif; mso-ascii-theme-font: minor-latin; mso-fareast-font-family: Calibri; mso-fareast-theme-font: minor-latin; mso-hansi-theme-font: minor-latin; mso-bidi-font-family: 'Times New Roman'; mso-bidi-theme-font: minor-bidi; mso-ansi-language: HU; mso-fareast-language: EN-US; mso-bidi-language: AR-SA; mso-no-proof: yes;\">11H(MARTIN)= Der heilige Martin; </span><br />11H(FLORIAN) * der Kriegermärtyrer Florian von Lorch, 73D24 * das Abendmahl (generell ) (Matthäus 26:21-35; Markus 14:18-31; Lukas 22:3, 22:15-23; Johannes 13:21-38)</p><p style=\"text-indent: 5%;\">Statuen auf dem Sockel: 11H(STEPHEN OF HUNGARY);&nbsp;61B2(LEOPOLD &lt;Österreich, Herzog, 3&gt;); 11H(JOHN THE BAPTIST) = Johannnes der Täufer, 11H(ANTONY OF PADUA) = der Franziskanermönch Antonius von Padua</p>" .

<http://foko2014.gnm.de/content/ecrm_E33_Linguistic_Object21e896> a ns1:E33_Linguistic_Object ;
    ns1:P3_has_note "<p>Errichtet in Erinnerung an die Rückeroberung der Stadt Buda 1686</p>" .

<http://foko2014.gnm.de/content/ecrm_E33_Linguistic_Object2325cc> a ns1:E33_Linguistic_Object ;
    ns1:P3_has_note "<p>Laut den Forschungen des Kunsthistorikers István Bibó stand der Architekt in keinem familiären Kontakt mit der Künstlerfamilie \"Canevale\" und er unterzeichnete immer als Ganneval. </p>" .

<http://foko2014.gnm.de/content/ecrm_E33_Linguistic_Object29e86a> a ns1:E33_Linguistic_Object ;
    ns1:P3_has_note "<p>? Identisch mit <span typeof=\"http://id.gnm.de/ont/foko/Person\" about=\"http://foko2014.gnm.de/content/foko_Person1f6a93\" class=\"wisski_anno wisski_anno_class_238 wisski_anno_approved wisski_anno_vocab_1 wisski_anno_uri_http%3A%2F%2Ffoko2014.gnm.de%2Fcontent%2Ffoko_Person1f6a93 \">Petrini, Giovanni Battista</span><span typeof=\"http://id.gnm.de/ont/foko/Person\" about=\"http://foko2014.gnm.de/content/2747c541-a3ef-4ea9-9658-ca4dd7cecbfd\" class=\"wisski_anno wisski_anno_class_238 wisski_anno_approved wisski_anno_uri_http%3A%2F%2Ffoko2014.gnm.de%2Fcontent%2F2747c541-a3ef-4ea9-9658-ca4dd7cecbfd \"></span><span style=\"font-size: 90%;\"></span></p>" .

<http://foko2014.gnm.de/content/ecrm_E33_Linguistic_Object36f739> a ns1:E33_Linguistic_Object ;
    ns1:P3_has_note "<p>Bei der Scanvorlage handelt es sich laut Dateiname um ein Negativ. Dieses Negativ wurde erkennbar von einem Positiv genommen. Es stellt sich wieder die Frage ob wir es hier mit einer \"neuen Ebene\" zu tun haben und wenn ja, wie man damit verfahren soll?</p>" .

<http://foko2014.gnm.de/content/ecrm_E33_Linguistic_Object37cc0d> a ns1:E33_Linguistic_Object ;
    ns1:P3_has_note "<p>Bei der Scanvorlage handelt es sich um ein Repro aus dem Jahr 1992.</p>" .

<http://foko2014.gnm.de/content/ecrm_E33_Linguistic_Object37ccd0> a ns1:E33_Linguistic_Object ;
    ns1:P3_has_note "<p>Bei der Scanvorlage handelt es sich um ein Repro aus dem Jahr 1992.</p>" .

<http://foko2014.gnm.de/content/ecrm_E33_Linguistic_Object37ce0a> a ns1:E33_Linguistic_Object ;
    ns1:P3_has_note "<p>Bei der Scanvorlage handelt es sich um ein Repro aus dem Jahr 1992.</p>" .

<http://foko2014.gnm.de/content/ecrm_E33_Linguistic_Object37ce73> a ns1:E33_Linguistic_Object ;
    ns1:P3_has_note "<p>Bei der Scanvorlage handelt es sich um ein Repro aus dem Jahr 1992.</p>" .

<http://foko2014.gnm.de/content/ecrm_E33_Linguistic_Object37cef2> a ns1:E33_Linguistic_Object ;
    ns1:P3_has_note "<p>Bei der Scanvorlage handelt es sich um ein repro aus dem Jahr 1992.</p>" .

<http://foko2014.gnm.de/content/ecrm_E33_Linguistic_Object3821af> a ns1:E33_Linguistic_Object ;
    ns1:P3_has_note "<p>Möglicherweise identisch mit Hans Spieß von Frankfurt (<a href=\"http://foko2014.gnm.de/content/foko_Personebe5b\">Spiess z Frankfurtu, Hans</a>)<span style=\"font-size: 90%;\"><br /></span></p>" .

<http://foko2014.gnm.de/content/ecrm_E33_Linguistic_Object3fff13> a ns1:E33_Linguistic_Object ;
    ns1:P3_has_note "<p><span class=\"wisski_anno wisski_anno_uri_http%3A%2F%2Ffoko2014.gnm.de%2Fcontent%2Ffoko_Persond3ad9 \">Möglicherweise identisch mit&nbsp; </span><a href=\"http://foko2014.gnm.de/content/foko_Persond3ad9\" class=\"wisski_anno wisski_anno_uri_http%3A%2F%2Ffoko2014.gnm.de%2Fcontent%2Ffoko_Persond3ad9 \">Meister Hans</a></p>" .

<http://foko2014.gnm.de/content/ecrm_E33_Linguistic_Object480990> a ns1:E33_Linguistic_Object ;
    ns1:P3_has_note "<p>Identisch mit Bartolomeo Fontana?</p>" .

<http://foko2014.gnm.de/content/ecrm_E33_Linguistic_Object4f1dae> a ns1:E33_Linguistic_Object ;
    ns1:P3_has_note "<p>Förderer der Wissenschaften in Siebenbürgen; Besitzer einer wertvollen, später in die rumänische Nationalbibliothek integrierten Bibliothek</p>" .

